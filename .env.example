# ---- Database ----
# Async SQLAlchemy URL used by the app (psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://copilot:copilot@db:5432/copilot

# Credentials for the bundled Postgres container (docker-compose).
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot

# ---- Security ----
# Signs session/JWT tokens for the password gate. Change in production.
SECRET_KEY=dev-insecure-change-me
# Fernet key for encrypting the Graph client secret at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-run admin bootstrap (only created when no app users exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_DIST=frontend/dist

# ---- Local host ports (docker-compose) ----
# Host-side ports the stack binds to. Change these to avoid clashing with other
# local solutions. Container-internal ports are unchanged, so DATABASE_URL
# (which uses db:5432 on the internal network) does NOT need editing.
#
# Each solution in the suite owns a distinct block so all four run side by side:
#   Usage Reporter 5432/8000 | Cowork Reporter 5433/8001
#   Agent Quality  5434/8002 | Prompt Analyser 5435/8003
#
# In production the API serves the built SPA, so the dashboard is on API_PORT
# and WEB_PORT applies only to docker-compose.dev.yml (the Vite dev server).
API_PORT=8000        # dashboard + FastAPI/docs at http://localhost:${API_PORT}
DB_PORT=5432         # Postgres, for direct psql/tooling access
WEB_PORT=5173        # Vite dev server, dev override only

# ---- Container images (production compose) ----
# Defaults are the public GHCR images published from the GitHub mirror.
# Point these at another registry to run images built elsewhere, or leave them
# blank and run `docker compose build` to build locally at deploy time.
API_IMAGE=
WORKER_IMAGE=

# ---- Ingest tuning ----
INGEST_CONCURRENCY=15
DEFAULT_BACKFILL_DAYS=30
