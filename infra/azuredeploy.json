{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "One-click deploy of the M365 Copilot Usage Reporter to Azure Container Apps. Pulls prebuilt public images from GitHub Container Registry, provisions a PostgreSQL flexible server, and wires everything together. Only an admin password is required; all other secrets are generated automatically."
  },
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "copilot",
      "minLength": 2,
      "maxLength": 12,
      "metadata": {
        "description": "Short prefix for resource names. Use lowercase letters/numbers and start with a letter (e.g. 'copilot'). Kept short so Container App names stay within Azure's 32-character limit."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "imageRegistry": {
      "type": "string",
      "defaultValue": "ghcr.io/loryanstrant/m365copilot-usage-reporter",
      "metadata": {
        "description": "Registry path holding the public 'api' and 'worker' images."
      }
    },
    "imageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Image tag to deploy (e.g. 'latest' or a version like 'v1.0.0')."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "admin",
      "metadata": {
        "description": "Username for the first dashboard sign-in."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "minLength": 8,
      "metadata": {
        "description": "Password for the first dashboard sign-in. Choose a strong value."
      }
    },
    "postgresAdminPassword": {
      "type": "securestring",
      "defaultValue": "[concat('Pg', uniqueString(resourceGroup().id, deployment().name), toUpper(uniqueString(subscription().subscriptionId, resourceGroup().id)), '#9aZ')]",
      "metadata": {
        "description": "Internal PostgreSQL admin password. Generated automatically; you never need to enter or see it."
      }
    },
    "fernetKey": {
      "type": "securestring",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "Secret used to encrypt the Graph client secret at rest. Generated automatically."
      }
    },
    "secretKey": {
      "type": "securestring",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "Secret used to sign session tokens. Generated automatically."
      }
    },
    "enableEntraAuth": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable Entra ID single sign-on (Container Apps Easy Auth) so licensed users can view the dashboard with their work account. Leave off to use only the admin password. When on, provide the Entra app registration client ID and secret below."
      }
    },
    "entraClientId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Only used when Entra SSO is enabled. Application (client) ID of the app registration used for sign-in. You can reuse the reporter's own app registration."
      }
    },
    "entraClientSecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Only used when Entra SSO is enabled. A client secret for the sign-in app registration."
      }
    },
    "entraTenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]",
      "metadata": {
        "description": "Only used when Entra SSO is enabled. Directory (tenant) ID that issues sign-in tokens. Defaults to the deployment tenant."
      }
    },
    "postgresVersion": {
      "type": "string",
      "defaultValue": "16",
      "allowedValues": [ "17", "16", "15", "14" ],
      "metadata": {
        "description": "PostgreSQL major version. If deployment fails with \"The value of the 'Version' should be in: []\", the target region does not offer this version/SKU combination — deploy to a fully supported region (e.g. australiaeast, eastus, westeurope) or change postgresSkuName/postgresSkuTier."
      }
    },
    "postgresSkuName": {
      "type": "string",
      "defaultValue": "Standard_B1ms",
      "metadata": {
        "description": "PostgreSQL Flexible Server compute size. Default is the cheapest burstable size. If your region lacks Burstable capacity, switch to a General Purpose size such as 'Standard_D2ds_v5' and set postgresSkuTier to 'GeneralPurpose'."
      }
    },
    "postgresSkuTier": {
      "type": "string",
      "defaultValue": "Burstable",
      "allowedValues": [ "Burstable", "GeneralPurpose", "MemoryOptimized" ],
      "metadata": {
        "description": "Compute tier that matches postgresSkuName (Burstable for B-series, GeneralPurpose for D-series, MemoryOptimized for E-series)."
      }
    }
  },
  "variables": {
    "prefix": "[toLower(parameters('namePrefix'))]",
    "resourceToken": "[take(toLower(uniqueString(resourceGroup().id, parameters('namePrefix'))), 8)]",
    "logsName": "[format('{0}-log-{1}', variables('prefix'), variables('resourceToken'))]",
    "envName": "[format('{0}-cae-{1}', variables('prefix'), variables('resourceToken'))]",
    "pgServerName": "[format('{0}-psql-{1}', variables('prefix'), variables('resourceToken'))]",
    "pgAdminLogin": "copilotadmin",
    "pgDatabaseName": "copilot",
    "apiAppName": "[format('{0}-api-{1}', variables('prefix'), variables('resourceToken'))]",
    "workerAppName": "[format('{0}-worker-{1}', variables('prefix'), variables('resourceToken'))]",
    "apiImage": "[format('{0}/api:{1}', parameters('imageRegistry'), parameters('imageTag'))]",
    "workerImage": "[format('{0}/worker:{1}', parameters('imageRegistry'), parameters('imageTag'))]",
    "databaseUrl": "[format('postgresql+psycopg://{0}:{1}@{2}.postgres.database.azure.com:5432/{3}?sslmode=require', variables('pgAdminLogin'), parameters('postgresAdminPassword'), variables('pgServerName'), variables('pgDatabaseName'))]",
    "sharedSecrets": [
      { "name": "database-url", "value": "[variables('databaseUrl')]" },
      { "name": "fernet-key", "value": "[parameters('fernetKey')]" },
      { "name": "secret-key", "value": "[parameters('secretKey')]" },
      { "name": "admin-password", "value": "[parameters('adminPassword')]" }
    ],
    "sharedEnv": [
      { "name": "DATABASE_URL", "secretRef": "database-url" },
      { "name": "FERNET_KEY", "secretRef": "fernet-key" },
      { "name": "SECRET_KEY", "secretRef": "secret-key" },
      { "name": "ADMIN_USERNAME", "value": "[parameters('adminUsername')]" },
      { "name": "ADMIN_PASSWORD", "secretRef": "admin-password" },
      { "name": "APP_ENV", "value": "production" }
    ],
    "apiSecrets": "[if(parameters('enableEntraAuth'), concat(variables('sharedSecrets'), createArray(createObject('name', 'aad-client-secret', 'value', parameters('entraClientSecret')))), variables('sharedSecrets'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": { "name": "PerGB2018" },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[variables('pgServerName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('postgresSkuName')]",
        "tier": "[parameters('postgresSkuTier')]"
      },
      "properties": {
        "version": "[parameters('postgresVersion')]",
        "administratorLogin": "[variables('pgAdminLogin')]",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "storage": { "storageSizeGB": 32 },
        "backup": { "backupRetentionDays": 7, "geoRedundantBackup": "Disabled" },
        "highAvailability": { "mode": "Disabled" },
        "network": { "publicNetworkAccess": "Enabled" }
      },
      "resources": [
        {
          "type": "databases",
          "apiVersion": "2024-08-01",
          "name": "[variables('pgDatabaseName')]",
          "dependsOn": [
            "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgServerName'))]"
          ]
        },
        {
          "type": "firewallRules",
          "apiVersion": "2024-08-01",
          "name": "AllowAllAzureServices",
          "dependsOn": [
            "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgServerName'))]",
            "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', variables('pgServerName'), variables('pgDatabaseName'))]"
          ],
          "properties": {
            "startIpAddress": "0.0.0.0",
            "endIpAddress": "0.0.0.0"
          }
        }
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('envName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logsName'))]"
      ],
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logsName')), '2023-09-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('apiAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgServerName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', variables('pgServerName'), variables('pgDatabaseName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', variables('pgServerName'), 'AllowAllAzureServices')]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": "[variables('apiSecrets')]"
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[variables('apiImage')]",
              "resources": { "cpu": "[json('0.5')]", "memory": "1Gi" },
              "env": "[concat(variables('sharedEnv'), createArray(createObject('name', 'RUN_MIGRATIONS_ON_STARTUP', 'value', 'true')))]"
            }
          ],
          "scale": { "minReplicas": 1, "maxReplicas": 3 }
        }
      }
    },
    {
      "condition": "[parameters('enableEntraAuth')]",
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/current', variables('apiAppName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('apiAppName'))]"
      ],
      "properties": {
        "platform": { "enabled": true },
        "globalValidation": { "unauthenticatedClientAction": "AllowAnonymous" },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "registration": {
              "openIdIssuer": "[format('https://login.microsoftonline.com/{0}/v2.0', parameters('entraTenantId'))]",
              "clientId": "[parameters('entraClientId')]",
              "clientSecretSettingName": "aad-client-secret"
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('entraClientId')]",
                "[format('api://{0}', parameters('entraClientId'))]"
              ]
            }
          }
        },
        "login": {
          "tokenStore": { "enabled": true }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('workerAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('pgServerName'))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', variables('pgServerName'), variables('pgDatabaseName'))]",
        "[resourceId('Microsoft.App/containerApps', variables('apiAppName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "secrets": "[variables('sharedSecrets')]"
        },
        "template": {
          "containers": [
            {
              "name": "worker",
              "image": "[variables('workerImage')]",
              "resources": { "cpu": "[json('0.5')]", "memory": "1Gi" },
              "env": "[concat(variables('sharedEnv'), createArray(createObject('name', 'RUN_MIGRATIONS_ON_STARTUP', 'value', 'false')))]"
            }
          ],
          "scale": { "minReplicas": 1, "maxReplicas": 1 }
        }
      }
    }
  ],
  "outputs": {
    "dashboardUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('apiAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "adminUsername": {
      "type": "string",
      "value": "[parameters('adminUsername')]"
    },
    "entraRedirectUriToRegister": {
      "type": "string",
      "value": "[if(parameters('enableEntraAuth'), format('https://{0}/.auth/login/aad/callback', reference(resourceId('Microsoft.App/containerApps', variables('apiAppName')), '2024-03-01').configuration.ingress.fqdn), 'Entra SSO disabled')]",
      "metadata": {
        "description": "When Entra SSO is enabled, add this URL as a Web redirect URI on your app registration."
      }
    }
  }
}
